generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is the engine for AWS Amplify's servers (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            Int            @id @default(autoincrement())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean        @default(false)
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  reports       ReviewReport[]
  submissions   Submission[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// a university; Course.code and Professor.externalKey are unique within one school
model School {
  id          Int          @id @default(autoincrement())
  key         String       @unique // short name used in links and imports, e.g. "usfq"
  name        String
  courses     Course[]
  professors  Professor[]
  submissions Submission[]
}

model Course {
  id          Int               @id @default(autoincrement())
  code        String? // the school's catalog code, e.g. "ART 1101"
  name        String
  description String            @default("")
  Department  String
  userAdded   Boolean           @default(false) // added from a student's suggestion, not the school's catalog
  schoolId    Int
  school      School            @relation(fields: [schoolId], references: [id])
  professors  CourseProfessor[] // Establish many-to-many relationship with Professor
  Review      Review[]
  submissions Submission[]

  @@unique([schoolId, code]) // lets imports update a course instead of duplicating it
}

model Professor {
  id          Int               @id @default(autoincrement())
  Firstname   String
  Lastname    String
  Prefix      String?
  displayName String? // full name as the school lists it, e.g. "Idrovo Pérez, Gustavo"
  externalKey String? // the school's id for this professor, or their normalized name
  Verified    Boolean           @default(false)
  userAdded   Boolean           @default(false) // added from a student's suggestion, not the school's catalog
  schoolId    Int
  school      School            @relation(fields: [schoolId], references: [id])
  courses     CourseProfessor[] // Establish many-to-many relationship with Course
  Review      Review[]
  submissions Submission[]

  @@unique([schoolId, externalKey]) // lets imports update a professor instead of duplicating them
}

model CourseProfessor {
  courseId    Int
  professorId Int
  term        String? // term of the last import that listed this pairing, e.g. "202610"
  course      Course    @relation(fields: [courseId], references: [id])
  professor   Professor @relation(fields: [professorId], references: [id])

  @@id([courseId, professorId]) // Composite primary key
}

model Review {
  id             Int                 @id @default(autoincrement())
  courseId       Int
  professorId    Int
  userId         Int
  overallRating  Float
  difficulty     Float
  workload       Float
  lecture        Float
  learning       Float
  wouldTakeAgain Boolean? // null on reviews written before the question existed, or when skipped
  comment        String
  hidden         Boolean             @default(false) // hidden by an admin; never shown publicly
  createdAt      DateTime            @default(now())
  course         Course              @relation(fields: [courseId], references: [id])
  professor      Professor           @relation(fields: [professorId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  reports        ReviewReport[]
  translations   ReviewTranslation[]

  @@unique([userId, professorId, courseId]) // one review per user per professor and course
}

// a signed-in user flagging a review for an admin to look at
model ReviewReport {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  userId    Int
  reason    String?
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId]) // one report per user per review
}

// a review comment machine-translated into another language, kept so each one is translated once
model ReviewTranslation {
  reviewId    Int
  language    String // "en" or "es"
  source      String // the comment that was translated; a mismatch means the review was edited since
  translation String
  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, language])
}

// a student's suggestion that a professor teaches a course the site is missing. Each side is either
// an existing record (professorId / courseId) or a new one described by the other fields, so it can
// add a professor, a course, both, or just the pairing. An admin approves or rejects it on /admin.
model Submission {
  id          Int        @id @default(autoincrement())
  schoolId    Int
  userId      Int
  professorId Int? // the existing professor, or the one created on approval
  firstName   String? // a new professor's names, when professorId was empty
  lastName    String?
  courseId    Int? // the existing course, or the one created on approval
  courseCode  String? // a new course's catalog code (optional) and title
  courseName  String?
  department  String?
  note        String? // anything else the student wants the admin to know
  status      String     @default("pending") // "pending", "approved" or "rejected"
  createdAt   DateTime   @default(now())
  reviewedAt  DateTime?
  school      School     @relation(fields: [schoolId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status])
}
